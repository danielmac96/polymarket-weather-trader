# ─────────────────────────────────────────────────────────────
# Shared (packages/shared)
# ─────────────────────────────────────────────────────────────
# Postgres connection string. Default for docker-compose.yml.
DATABASE_URL=postgresql://pwa:pwa@localhost:5432/pwa

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Collector (packages/collector)
# ─────────────────────────────────────────────────────────────
# NOAA requires a contact identifier in User-Agent.
# Format: "app-name/version (contact-email)"
NOAA_USER_AGENT=polymarket-weather-app/0.1 (contact@example.com)

# ─────────────────────────────────────────────────────────────
# Analyzer (packages/analyzer)
# ─────────────────────────────────────────────────────────────
# Trading behavior (unit size, risk tolerance, edge threshold, Kelly
# fraction, exposure caps) is configured at runtime from the dashboard's
# Settings page and stored in the trading_settings table — not env vars.

# Market filters
MIN_MARKET_VOLUME_USD=500
MIN_MARKET_LIQUIDITY_USD=200

# Focus mode: track one market family only. Default = the daily
# "Highest temperature in NYC" market (the most liquid weather market).
# Set FOCUS_ENABLED=false to track all US weather markets.
FOCUS_ENABLED=true
FOCUS_QUERY=highest temperature
FOCUS_LOCATION=NYC

# Hard kill switch for auto trading. The day-to-day toggle lives in the
# dashboard Settings page; setting this to false disables auto trading
# regardless of the dashboard toggle.
AUTO_PAPER_TRADE=true

# ─────────────────────────────────────────────────────────────
# Portfolio (packages/portfolio)
# ─────────────────────────────────────────────────────────────
PAPER_STARTING_BANKROLL_USD=1000
# Absolute per-position backstop in USD, applied on top of the
# risk-profile caps configured in the dashboard.
MAX_PAPER_POSITION_USD=100

# ─────────────────────────────────────────────────────────────
# Trading flag — MUST remain false for MVP.
# ─────────────────────────────────────────────────────────────
LIVE_TRADING_ENABLED=false
